<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.nubons</groupId>
		<artifactId>abstract-nnp</artifactId>
		<version>1.0.0</version>
		<relativePath/>
	</parent>
	<groupId>com.nubons.nnp.lcnc.codegen</groupId>
	<artifactId>mapperfactory</artifactId>
	<version>1.0.3</version>
	<name>mapperfactory</name>
	<description>A factory of data mapper utility</description>

	<!-- Public, token-free Maven repo (GitHub Pages) that hosts the abstract-nnp parent POM -->
	<repositories>
		<repository>
			<id>nnp-public</id>
			<url>https://nubo-native-platform.github.io/PICC-PC-Abstract-NNP-Platform/maven/</url>
		</repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/Nubo-Native-Platform/SD-ELC-EG-Codegen-Framework</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
		</dependency>
	</dependencies>
</project>
